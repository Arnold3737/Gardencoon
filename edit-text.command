#!/usr/bin/env bash
# =========================================================================
#  Garden State Coon — Изменить текст на сайте (macOS)
#
#  КАК ПОЛЬЗОВАТЬСЯ:
#    Дважды кликните по этому файлу (edit-text.command).
#    Отвечайте на вопросы: выберите страницу, вставьте старый текст,
#    введите новый — и изменение само уедет на сайт.
#
#  Первый раз на macOS: если файл не запускается двойным кликом,
#  выполните один раз в Терминале:  chmod +x edit-text.command
#  Путь к репозиторию определяется автоматически.
# =========================================================================
set -e
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT="$REPO/scripts/edit-text.js"

if [ ! -f "$SCRIPT" ]; then
  echo "[ОШИБКА] Не найден scripts/edit-text.js рядом с этим файлом."
  echo "Этот файл должен лежать в корне репозитория Gardencoon."
  read -r -p "Нажмите Enter для выхода..."
  exit 1
fi

cd "$REPO"
node "$SCRIPT"

echo ""
echo "[ГОТОВО] Если были изменения — сайт обновится через ~1 минуту."
read -r -p "Нажмите Enter для выхода..."
